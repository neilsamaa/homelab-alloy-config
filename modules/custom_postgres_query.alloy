declare "custom_postgres_query" {
  argument "forward_to" {
    optional = false
  }
  argument "db_dsn" {
    optional = false
  }

  // Menggunakan exporter khusus SQL
  prometheus.exporter.sql "bisnis_metrics" {
    data_source_name = argument.db_dsn.value
    driver_name      = "postgres"

    // Menjalankan query custom 
    query {
      // Nama metrik yang akan muncul di Prometheus/Grafana
      // Hasil akhir metrik: grafana_org_users_total
      query_name = "grafana_org_users" 
      
      // PERBAIKAN: Gunakan fungsi agregasi (COUNT) dan alias kolom (AS total)
      // agar sesuai dengan ekspektasi value_name dan label_names di bawah.
      query      = "SELECT role, COUNT(user_id) AS total FROM org_user GROUP BY role;"
      
      // Kolom 'total' dari hasil query SQL akan dijadikan nilai angka metriknya
      value_name = "total"
      value_type = "gauge"
      
      // Kolom 'role' dari hasil query SQL akan dijadikan label
      // (misal metriknya nanti menjadi: grafana_org_users_total{role="Admin"} 10)
      label_names = ["role"] 
    }
  }

  // Melakukan scrape dari hasil query di atas
  prometheus.scrape "scrape_sql" {
    targets    = prometheus.exporter.sql.bisnis_metrics.targets
    forward_to = argument.forward_to.value
    
    clustering {
      enabled = true
    }
  }
}
