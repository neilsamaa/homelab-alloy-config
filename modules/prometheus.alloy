declare "node_exporter" {
  // Mendefinisikan argumen agar receiver bisa disuntikkan dari luar
  argument "forward_to" {
    optional = false
  }

  prometheus.scrape "node_metrics" {
    targets = [
      {"__address__" = "node-exporter:9100"},
    ]
    // Meneruskan metrik ke argumen yang diberikan
    forward_to = argument.forward_to.value
    
    clustering {
      enabled = true
    }
  }
}
