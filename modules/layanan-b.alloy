declare "node_exporter_layanan_b" {
  argument "forward_to" {
    optional = false
  }

  prometheus.scrape "layanan_b_metrics" {
    targets = [
      {"__address__" = "10.10.10.206:9100", "env" = "staging", "service" = "layanan-b"},
      // {"__address__" = "10.10.10.209:9100", "env" = "production", "service" = "layanan-b"},
      // {"__address__" = "10.10.10.209:9100", "env" = "production", "service" = "layanan-b"},
      // {"__address__" = "10.10.10.209:9100", "env" = "production", "service" = "layanan-b"},
    ]
    
    forward_to = argument.forward_to.value

    clustering {
      enabled = true
    }
  }
}
