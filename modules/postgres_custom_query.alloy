declare "postgres_custom_query" {
  argument "forward_to" {
    optional = false
  }

  argument "db_dsn" {
    optional = false
  }

  // --- KOMPONEN EXPORTER POSTGRESQL ---
  prometheus.exporter.postgres "custom_queries" {
    data_source_names = [argument.db_dsn.value]
    
    custom_queries_config_path = "/etc/alloy/targets/queries.yaml"

    // Opsional: Jika diset true, metrik bawaan (CPU/RAM DB) akan dimatikan
    disable_default_metrics = true 
  }

  prometheus.scrape "scrape_custom_queries" {
    targets    = prometheus.exporter.postgres.custom_queries.targets
    forward_to = argument.forward_to.value
    job_name     = "postgres_custom"
    
    clustering {
      enabled = true
    }
  }
}
